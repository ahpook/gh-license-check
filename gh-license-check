#!/usr/bin/env bash
# Entrypoint that `gh` invokes for this extension.
# Keeps the real logic in a hand-editable Python package (license_check/).
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if ! command -v python3 >/dev/null 2>&1; then
  echo "gh-license-check requires python3 on your PATH." >&2
  exit 1
fi

export PYTHONPATH="${here}${PYTHONPATH:+:${PYTHONPATH}}"
exec python3 -m license_check "$@"
